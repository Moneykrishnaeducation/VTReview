{
  "name": "Frontend",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "dev:web": "vp run --fail-if-no-match --filter web dev",
    "check": "vp run -r check",
    "lint": "vp run -r lint",
    "format": "vp run -r format",
    "test": "vp run -r test",
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks"
  },
  "dependencies": {
    "@Frontend/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Frontend/config": "workspace:*",
    "@voidzero-dev/vite-plus-core": "^0.2.9",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.9"
  },
  "overrides": {
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.9",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
